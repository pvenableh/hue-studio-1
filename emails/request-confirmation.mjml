<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Avenir Next', 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" color="#1d1d1f" line-height="1.6" font-weight="400" padding="0" />
      <mj-class name="eyebrow" font-size="11px" color="#86868b" letter-spacing="2px" text-transform="uppercase" font-weight="600" />
      <mj-class name="heading" font-size="30px" color="#1d1d1f" line-height="1.2" font-weight="500" letter-spacing="-0.4px" />
      <mj-class name="body-text" font-size="16px" color="#1d1d1f" line-height="1.65" />
      <mj-class name="muted" font-size="14px" color="#86868b" line-height="1.65" />
      <mj-class name="label" font-size="10px" color="#86868b" letter-spacing="2px" text-transform="uppercase" font-weight="600" />
    </mj-attributes>
    <mj-preview>Thanks, {{first_name}} — we've received your request and we'll be in touch shortly.</mj-preview>
    <mj-style>
      a { color: #1d1d1f; text-decoration: underline; }
      .step-num { color: #c7c7c7; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    <!-- Header -->
    <mj-section background-color="#ffffff" padding="32px 40px 12px">
      <mj-column>
        <mj-image src="https://admin.earnest.guru/assets/cf9d5f4f-9a30-418d-b48e-acb037c3c2c9?key=email-small" alt="Hue Studios" href="https://huestudios.com" width="56px" align="left" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#ffffff" padding="44px 40px 8px">
      <mj-column>
        <mj-text mj-class="eyebrow" padding-bottom="18px">Request Received</mj-text>
        <mj-text mj-class="heading" padding-bottom="20px">Thanks, {{first_name}}.</mj-text>
        <mj-text mj-class="body-text" padding-bottom="0">
          We've received your {{request_type}}request and it's landed with our team. A real person at Hue will review it and reach out within one business day.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- What happens next -->
    <mj-section background-color="#ffffff" padding="28px 40px 0">
      <mj-column>
        <mj-text mj-class="label" align="left" padding-bottom="16px">What happens next</mj-text>
        <mj-text mj-class="body-text" align="left" padding-bottom="12px"><span class="step-num">01&nbsp;&nbsp;</span>We review what you sent and get familiar with your goals.</mj-text>
        <mj-text mj-class="body-text" align="left" padding-bottom="12px"><span class="step-num">02&nbsp;&nbsp;</span>A member of our team reaches out to set up a conversation.</mj-text>
        <mj-text mj-class="body-text" align="left" padding-bottom="0"><span class="step-num">03&nbsp;&nbsp;</span>Together we map out the right next step for your brand.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Reassurance -->
    <mj-section background-color="#ffffff" padding="28px 40px 0">
      <mj-column>
        <mj-text mj-class="muted" padding-bottom="0">
          Have something to add? Just reply to this email — it goes straight to our team.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="24px 40px 8px">
      <mj-column>
        <mj-button background-color="#1d1d1f" color="#ffffff" font-size="11px" font-weight="600" letter-spacing="1.5px" text-transform="uppercase" border-radius="2px" inner-padding="14px 26px" href="{{cta_url}}" align="left" padding="0">
          Explore our work
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#ffffff" padding="88px 40px 32px">
      <mj-column>
        <mj-text align="center" font-size="9px" color="#86868b" font-weight="600" letter-spacing="2px" text-transform="uppercase" padding="0 0 4px 0">
          <a href="https://huestudios.com" style="color:#86868b;text-decoration:none;">Hue</a>
        </mj-text>
        <mj-text align="center" font-size="9px" color="#86868b" letter-spacing="2px" text-transform="uppercase" line-height="1.8" padding="0 0 4px 0">
          605 Lincoln Road, Suite 200 &middot; Miami Beach, FL 33139
        </mj-text>
        <mj-text align="center" font-size="9px" color="#c7c7c7" letter-spacing="2px" text-transform="uppercase" padding="0">
          &copy; 2026 Hue Studios, LLC
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
